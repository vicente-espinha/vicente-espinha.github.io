---
import Icon from './Icon.astro';
import TechPills from './TechPills.astro';
import type { Project } from '../data/projects';

interface Props {
  item: Project;
  delay?: number;
}

const { item, delay = 0 } = Astro.props;
---

<li class="reveal mb-12 transition-opacity duration-300" style={`--reveal-delay: ${delay}ms`}>
  <div class="group relative pb-1 transition-all">
    <div
      class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-lg transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-surface/60 group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] group-hover:drop-shadow-lg lg:-inset-x-6 lg:block"
    >
    </div>
    <div class="relative z-10">
      <h3>
        <a
          class="group/link inline-flex items-baseline text-base font-medium leading-tight text-heading hover:text-accent focus-visible:text-accent"
          href={item.href}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={`${item.title} (opens in a new tab)`}
        >
          <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block" />
          <span>{item.title}</span>
          <Icon
            name="arrow-up-right"
            class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
          />
        </a>
      </h3>
      <p class="mt-2 text-sm leading-normal">{item.description}</p>
      <TechPills items={item.tech} />
    </div>
  </div>
</li>
