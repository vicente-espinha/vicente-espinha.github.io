---
import PipelineArt from './art/PipelineArt.astro';
import WaferArt from './art/WaferArt.astro';
import ChartArt from './art/ChartArt.astro';
import Icon from './Icon.astro';
import type { Work } from '../data/work';

interface Props {
  item: Work;
  delay?: number;
}

const { item, delay = 0 } = Astro.props;

const themes = {
  green: { bg: 'linear-gradient(165deg, #1a3d2f 0%, #10241b 100%)', art: '#7ee0b0' },
  violet: { bg: 'linear-gradient(165deg, #2a2348 0%, #16132b 100%)', art: '#b9a8ff' },
  amber: { bg: 'linear-gradient(165deg, #3d2c15 0%, #1f170c 100%)', art: '#ffc46b' },
};
const theme = themes[item.theme];
---

<li class="reveal" style={`--reveal-delay: ${delay}ms`}>
  <article
    class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-white/[0.06] shadow-[0_1px_0_0_rgba(255,255,255,0.06)_inset] transition-all duration-500 ease-out hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/40"
    style={`background: ${theme.bg}; --art: ${theme.art}`}
  >
    <header class="px-6 pt-6">
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em]" style="color: var(--art)">{item.kicker}</p>
      <h3 class="mt-2 font-serif text-[1.75rem] leading-tight text-heading">
        {item.title} <em class="italic" style="color: var(--art)">{item.titleAccent}</em>
      </h3>
      <p class="mt-1.5 text-sm text-text">{item.summary}</p>
    </header>

    <div class="flex flex-1 items-center justify-center px-6 py-4">
      <div class="aspect-[30/33] w-full max-w-[18rem] transition-transform duration-700 ease-out group-hover:scale-[1.04]">
        {item.art === 'pipeline' && <PipelineArt />}
        {item.art === 'wafer' && <WaferArt />}
        {item.art === 'chart' && <ChartArt />}
      </div>
    </div>

    <footer class="flex items-center justify-between gap-3 border-t border-white/[0.06] bg-black/15 px-6 py-4">
      <div class="min-w-0">
        <p class="truncate text-sm font-medium text-heading">{item.org}</p>
        <p class="text-xs text-muted">{item.period}</p>
      </div>
      {
        item.href && (
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer noopener"
            class="group/btn inline-flex shrink-0 items-center gap-1 rounded-full bg-white/90 px-3.5 py-1.5 text-xs font-semibold text-bg transition hover:bg-white"
          >
            {item.linkLabel ?? 'View'}
            <Icon name="arrow-up-right" class="h-3.5 w-3.5 transition-transform group-hover/btn:-translate-y-px group-hover/btn:translate-x-px" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        )
      }
    </footer>
  </article>
</li>
