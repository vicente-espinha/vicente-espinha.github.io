---
// SQL Server → Kafka → ClickHouse, with data flowing down the pipe.
const bars = [34, 52, 26, 60, 44, 38, 56];
---

<svg viewBox="0 0 300 330" class="h-full w-full" role="img" aria-label="Diagram: SQL Server streams changes through Apache Kafka into ClickHouse">
  <g font-family="Inter Variable, sans-serif">
    <!-- SQL Server -->
    <g transform="translate(55 20)">
      <rect width="190" height="62" rx="14" fill="rgba(255,255,255,0.04)" stroke="var(--art)" stroke-opacity="0.35" />
      <g transform="translate(18 15)" fill="none" stroke="var(--art)" stroke-width="1.5">
        <ellipse cx="14" cy="5" rx="14" ry="5" />
        <path d="M0 5v22c0 2.8 6.3 5 14 5s14-2.2 14-5V5" />
        <path d="M0 16c0 2.8 6.3 5 14 5s14-2.2 14-5" opacity="0.6" />
      </g>
      <text x="62" y="28" fill="#e6efe9" font-size="14" font-weight="600">SQL Server</text>
      <text x="62" y="45" fill="var(--art)" fill-opacity="0.8" font-size="10.5">change data capture</text>
    </g>

    <line x1="150" y1="84" x2="150" y2="124" stroke="var(--art)" stroke-width="2" class="flow-line" />

    <!-- Kafka -->
    <g transform="translate(35 126)">
      <rect width="230" height="78" rx="14" fill="rgba(255,255,255,0.04)" stroke="var(--art)" stroke-opacity="0.35" />
      <text x="18" y="25" fill="#e6efe9" font-size="14" font-weight="600">Apache Kafka</text>
      <text x="212" y="25" fill="var(--art)" fill-opacity="0.8" font-size="10.5" text-anchor="end">3 partitions</text>
      {
        [40, 52, 64].map((y, i) => (
          <>
            <line x1="18" y1={y} x2="212" y2={y} stroke="rgba(255,255,255,0.08)" stroke-width="6" stroke-linecap="round" />
            <line
              x1="18"
              y1={y}
              x2="212"
              y2={y}
              stroke="var(--art)"
              stroke-width="2"
              stroke-linecap="round"
              class="flow-line"
              style={`animation-duration: ${0.9 + i * 0.35}s`}
            />
          </>
        ))
      }
    </g>

    <line x1="150" y1="206" x2="150" y2="244" stroke="var(--art)" stroke-width="2" class="flow-line" />

    <!-- ClickHouse -->
    <g transform="translate(55 246)">
      <rect width="190" height="66" rx="14" fill="rgba(255,255,255,0.04)" stroke="var(--art)" stroke-opacity="0.35" />
      <g transform="translate(18 46)">
        {
          bars.map((h, i) => (
            <rect
              x={i * 7}
              y={-h / 2}
              width="4"
              height={h / 2}
              rx="1"
              fill="var(--art)"
              class="pulse-soft"
              style={`--d: ${i * 0.22}s`}
            />
          ))
        }
      </g>
      <text x="76" y="31" fill="#e6efe9" font-size="14" font-weight="600">ClickHouse</text>
      <text x="76" y="48" fill="var(--art)" fill-opacity="0.8" font-size="10.5">analytics for MES</text>
    </g>
  </g>
</svg>
