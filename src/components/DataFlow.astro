---
// Background: a faint dot grid that sweeps in on load, with glowing "packets"
// of data streaming along its lines. Grid points near the cursor light up.
---

<canvas id="dataflow" aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen w-full"></canvas>

<style>
  #dataflow {
    /* Sits behind the hero only and fades out at the bottom edge. */
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at 70% 20%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 85% at 70% 20%, #000 30%, transparent 100%);
  }
</style>

<script>
  import { startDataFlow } from '../scripts/dataflow';
  const canvas = document.getElementById('dataflow') as HTMLCanvasElement | null;
  if (canvas) startDataFlow(canvas);
</script>
