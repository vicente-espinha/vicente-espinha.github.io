---
interface Props {
  items: string[];
  label?: string;
}

const { items, label = 'Technologies used' } = Astro.props;
---

<ul class="mt-3 flex flex-wrap gap-2" aria-label={label}>
  {
    items.map((t) => (
      <li class="flex items-center rounded-full bg-accent/10 px-3 py-1 text-xs font-medium leading-5 text-accent">
        {t}
      </li>
    ))
  }
</ul>
