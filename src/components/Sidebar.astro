---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

// Split the name into words → letters so each letter can animate in on its own.
let letterIndex = 0;
const nameWords = profile.name.split(' ').map((word) =>
  word.split('').map((ch) => ({ ch, i: letterIndex++ })),
);

const nav = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
];
---

<header
  class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24"
>
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-heading sm:text-5xl">
      <a href="/" aria-label={profile.name}>
        {
          nameWords.map((word, w) => (
            <>
              <span class="inline-block whitespace-nowrap" aria-hidden="true">
                {word.map(({ ch, i }) => (
                  <span class="letter" style={`--i: ${i}`}>{ch}</span>
                ))}
              </span>
              {w < nameWords.length - 1 && ' '}
            </>
          ))
        }
      </a>
    </h1>
    <h2
      class="rise mt-3 text-lg font-medium tracking-tight text-heading sm:text-xl"
      style="--rise-delay: 550ms"
      data-scramble
      data-scramble-delay="600"
    >
      {profile.title}
    </h2>
    <p class="rise mt-4 max-w-xs leading-normal" style="--rise-delay: 1100ms">
      {profile.tagline}
    </p>
    <p
      class="rise mt-3 flex items-center gap-1.5 text-sm text-muted"
      style="--rise-delay: 1200ms"
    >
      <Icon name="pin" class="h-4 w-4" />
      {profile.location}
    </p>

    <nav class="rise hidden lg:block" style="--rise-delay: 1350ms" aria-label="In-page navigation">
      <ul class="mt-16 w-max">
        {
          nav.map((item) => (
            <li>
              <a
                class="nav-link group flex items-center py-3"
                href={`#${item.id}`}
                data-nav={item.id}
              >
                <span class="mr-4 h-px w-8 bg-muted transition-all duration-300 group-hover:w-16 group-hover:bg-heading group-focus-visible:w-16 group-focus-visible:bg-heading group-data-[active=true]:w-16 group-data-[active=true]:bg-heading" />
                <span class="text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-300 group-hover:text-heading group-focus-visible:text-heading group-data-[active=true]:text-heading">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="group flex items-center py-3" href="/blog/">
            <span class="mr-4 h-px w-8 bg-muted transition-all duration-300 group-hover:w-16 group-hover:bg-heading" />
            <span class="text-xs font-bold uppercase tracking-widest text-muted transition-colors duration-300 group-hover:text-heading">
              Blog
            </span>
            <span class="ml-2 rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent">
              Soon
            </span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <ul class="rise mt-8 flex items-center gap-5" style="--rise-delay: 1500ms" aria-label="Social media">
    {
      profile.socials.map((s) => (
        <li>
          <a
            class="block text-muted transition-all duration-300 hover:-translate-y-0.5 hover:text-heading"
            href={s.href}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={`${s.label} (opens in a new tab)`}
            title={s.label}
          >
            <Icon name={s.icon} class="h-6 w-6" />
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  import '../scripts/activeNav';
  import '../scripts/scramble';
</script>
