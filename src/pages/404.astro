---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`Page not found · ${profile.name}`}>
  <main id="content" class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="rise text-sm font-semibold uppercase tracking-widest text-accent">404</p>
    <h1 class="rise mt-4 text-4xl font-bold tracking-tight text-heading sm:text-5xl" style="--rise-delay: 100ms">
      Page not found
    </h1>
    <p class="rise mt-4" style="--rise-delay: 200ms">This page doesn't exist, or it moved.</p>
    <a
      href="/"
      class="rise group mt-10 inline-flex items-center gap-2 font-semibold text-accent"
      style="--rise-delay: 300ms"
    >
      <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
      Back home
    </a>
  </main>
</Base>
