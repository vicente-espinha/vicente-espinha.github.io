---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`Page not found · ${profile.name}`}>
  <section class="mx-auto flex max-w-6xl flex-col items-start px-6 pt-24 md:px-10 md:pt-32">
    <p class="rise text-sm text-muted">404</p>
    <h1 class="mt-4 font-serif text-6xl leading-[1.02] text-heading sm:text-7xl" aria-label="This packet got lost.">
      <span aria-hidden="true">
        <span class="word" style="--i: 0">This</span>
        <span class="word" style="--i: 1">packet</span>
        <em class="italic text-accent"><span class="word" style="--i: 2">got</span> <span class="word" style="--i: 3">lost.</span></em>
      </span>
    </h1>
    <p class="rise mt-6 text-lg" style="--rise-delay: 800ms">The page you're looking for doesn't exist, or it moved.</p>
    <a
      href="/"
      class="rise group mt-10 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-bg"
      style="--rise-delay: 950ms"
    >
      <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
      Back home
    </a>
  </section>
</Base>
