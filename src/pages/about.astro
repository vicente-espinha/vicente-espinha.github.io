---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { photos, PHOTO_GRID_MIN } from '../data/photos';

const greeting = ['Hi,', "I'm"].map((w, i) => ({ w, i }));
const facts = [
  { label: 'Now', value: `${experience[0].role.split(',')[0]} at ${profile.company}` },
  { label: 'Based in', value: profile.location },
  { label: 'Studied', value: 'Informatics & Computing Engineering, FEUP' },
];
const showGrid = photos.length >= PHOTO_GRID_MIN;
---

<Base title={`About · ${profile.name}`} description={`About ${profile.name}: career, interests and life off the clock.`}>
  <section class="mx-auto max-w-6xl px-6 pt-16 md:px-10 md:pt-24">
    <div class="grid items-center gap-12 md:grid-cols-[1fr_auto]">
      <div>
        <p class="rise text-sm text-muted">About</p>
        <h1 class="mt-4 font-serif text-6xl leading-[1.02] tracking-tight text-heading sm:text-7xl lg:text-8xl" aria-label="Hi, I'm Vicente.">
          <span aria-hidden="true">
            {greeting.map(({ w, i }) => <><span class="word" style={`--i: ${i}`}>{w}</span>{' '}</>)}
            <em class="italic text-accent"><span class="word" style="--i: 2">Vicente.</span></em>
          </span>
        </h1>
        <p class="rise mt-6 max-w-lg text-lg text-text" style="--rise-delay: 900ms">
          {profile.title} in {profile.location.split(',')[0]}. Reliable data systems by day; football, films and a
          growing list of places by night.
        </p>
      </div>

      <figure class="rise mx-auto w-56 sm:w-64 md:mx-0" style="--rise-delay: 300ms">
        <div class="group relative">
          <div class="absolute -inset-3 rotate-6 rounded-[2rem] bg-accent/15 transition-transform duration-700 group-hover:rotate-3" aria-hidden="true"></div>
          <img
            src="/photos/porto.jpg"
            alt="Vicente smiling with an ice cream in a street in Porto"
            width="900"
            height="1200"
            fetchpriority="high"
            class="relative aspect-[3/4] w-full -rotate-2 rounded-[1.75rem] object-cover shadow-2xl shadow-black/50 transition-transform duration-700 group-hover:rotate-0"
          />
        </div>
        <figcaption class="mt-4 text-center text-xs text-muted">porto, with gelato</figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto mt-24 grid max-w-6xl gap-14 px-6 md:grid-cols-[1.6fr_1fr] md:px-10">
    <div class="space-y-5 text-[1.05rem] leading-relaxed [&_a]:text-heading [&_a]:underline [&_a]:decoration-accent/50 [&_a]:underline-offset-4 [&_a:hover]:text-accent [&_strong]:font-semibold [&_strong]:text-heading">
      {profile.about.map((p, idx) => <p class="reveal" style={`--reveal-delay: ${idx * 90}ms`} set:html={p} />)}
    </div>

    <aside class="space-y-10">
      <dl class="reveal divide-y divide-line border-y border-line">
        {
          facts.map((f) => (
            <div class="flex flex-col gap-0.5 py-4">
              <dt class="text-xs uppercase tracking-widest text-muted">{f.label}</dt>
              <dd class="text-heading">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="reveal">
        <h2 class="text-xs uppercase tracking-widest text-muted">Off the clock</h2>
        <ul class="mt-4 flex flex-wrap gap-2.5">
          {
            profile.interests.map((it) => (
              <li class="flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm text-heading transition-colors duration-300 hover:border-accent/50 hover:text-accent">
                <span aria-hidden="true">{it.emoji}</span>
                {it.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal">
        <h2 class="text-xs uppercase tracking-widest text-muted">Tools I use daily</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            profile.skills.map((s) => (
              <li class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">{s}</li>
            ))
          }
        </ul>
      </div>
    </aside>
  </section>

  {
    showGrid && (
      <section class="mx-auto mt-28 max-w-6xl px-6 md:px-10" aria-labelledby="photos-title">
        <h2 id="photos-title" class="reveal font-serif text-4xl text-heading">
          Off <em class="italic text-accent">the clock</em>
        </h2>
        <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
          {photos.map((p, idx) => (
            <li class="reveal group relative overflow-hidden rounded-2xl" style={`--reveal-delay: ${(idx % 4) * 80}ms`}>
              <img
                src={p.src}
                alt={p.alt}
                loading="lazy"
                class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-3 pt-10 text-sm text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                {p.caption}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
