---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BLOG_ENABLED, profile } from '../../data/profile';

const posts = BLOG_ENABLED
  ? (await getCollection('blog', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
  : [];

const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={`Blog · ${profile.name}`} description={`Writing by ${profile.name}.`}>
  <section class="mx-auto max-w-6xl px-6 pt-16 md:px-10 md:pt-24">
    <p class="rise text-sm text-muted">Blog</p>
    <h1 class="mt-4 font-serif text-6xl leading-[1.02] tracking-tight text-heading sm:text-7xl" aria-label="Notes from the pipeline.">
      <span aria-hidden="true">
        <span class="word" style="--i: 0">Notes</span>
        <span class="word" style="--i: 1">from</span>
        <em class="italic text-accent"><span class="word" style="--i: 2">the</span> <span class="word" style="--i: 3">pipeline.</span></em>
      </span>
    </h1>

    {
      BLOG_ENABLED ? (
        <ul class="mt-16 border-t border-line">
          {posts.map((post, idx) => (
            <li class="reveal border-b border-line" style={`--reveal-delay: ${idx * 80}ms`}>
              <a href={`/blog/${post.id}/`} class="group -mx-4 grid gap-1 rounded-xl px-4 py-6 transition-colors hover:bg-surface/70 sm:grid-cols-[1fr_auto] sm:gap-8">
                <span>
                  <span class="block font-serif text-2xl text-heading transition-colors group-hover:text-accent">{post.data.title}</span>
                  <span class="mt-1 block text-sm text-text">{post.data.description}</span>
                </span>
                <span class="text-sm text-muted">{fmt.format(post.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="rise mt-14 max-w-xl rounded-3xl border border-line bg-surface/60 p-8" style="--rise-delay: 800ms">
          <span class="rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-accent">
            Coming soon
          </span>
          <p class="mt-5 text-lg text-text">
            I'll be writing about data platforms, replication and building software for manufacturing. Check back
            soon.
          </p>
        </div>
      )
    }
  </section>
</Base>
