---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BLOG_ENABLED, profile } from '../../data/profile';

const posts = BLOG_ENABLED
  ? (await getCollection('blog', ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
  : [];

const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={`Blog · ${profile.name}`} description={`Writing by ${profile.name}.`}>
  <main id="content" class="mx-auto flex min-h-screen max-w-2xl flex-col px-6 py-24 md:px-12">
    <a
      href="/"
      class="rise group mb-12 inline-flex w-max items-center gap-2 text-sm font-semibold text-accent"
    >
      <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
      {profile.name}
    </a>

    {
      BLOG_ENABLED ? (
        <>
          <h1 class="rise text-4xl font-bold tracking-tight text-heading">Blog</h1>
          <ul class="mt-12 space-y-10">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="group block">
                  <p class="text-xs uppercase tracking-wide text-muted">{fmt.format(post.data.date)}</p>
                  <h2 class="mt-1 text-lg font-medium text-heading group-hover:text-accent">{post.data.title}</h2>
                  <p class="mt-1 text-sm">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="flex flex-1 flex-col items-center justify-center text-center">
          <span class="rise rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-accent">
            Coming soon
          </span>
          <h1
            class="rise mt-6 text-4xl font-bold tracking-tight text-heading sm:text-5xl"
            style="--rise-delay: 100ms"
          >
            The blog is on its way.
          </h1>
          <p class="rise mt-4 max-w-md" style="--rise-delay: 200ms">
            I'll be writing about data platforms, replication and building software for
            manufacturing. Check back soon.
          </p>
        </div>
      )
    }
  </main>
</Base>
